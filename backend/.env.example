# =====================================================
# BACKEND ENVIRONMENT VARIABLES
# Set these in Render -> Environment Variables
# =====================================================
# Database - Neon PostgreSQL
# Neon Dashboard -> Connection Details -> JDBC dropdown
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-REPLACE.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here
SPRING_PROFILES_ACTIVE=prod
# JWT (generate: openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
# File uploads
FILE_UPLOAD_DIR=./uploads
# CORS
FRONTEND_URL=https://your-app.vercel.app
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# AI / OpenRouter
AI_API_KEY=sk-or-v1-your-openrouter-key-here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
